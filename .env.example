NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (no wildcard in production)
CORS_ORIGIN=http://localhost:3000

# SMTP credentials used to send campaign emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=RapidMailer

# Run Puppeteer headless (must be true on servers without a display)
PUPPETEER_HEADLESS=true

# Optional — raises the Google PageSpeed Insights rate limit used by the
# Website Audit tool. Works fine unauthenticated for occasional use.
GOOGLE_PAGESPEED_API_KEY=

# Official WhatsApp Business Cloud API (Meta). These are only used to seed
# settings.json the first time it's created — after that, whatever you save
# in Settings > Connect WhatsApp (sidebar) wins. See the Connect WhatsApp
# page in the app for step-by-step setup instructions.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v22.0
